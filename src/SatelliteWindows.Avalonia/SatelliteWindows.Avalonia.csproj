<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SatelliteWindows.Avalonia</RootNamespace>

    <!-- NuGet package metadata -->
    <PackageId>SatelliteWindows.Avalonia</PackageId>
    <Version>1.0.0</Version>
    <Authors>SatelliteWindows Contributors</Authors>
    <Description>Multi-window snapping library for Avalonia UI — magnetic satellite windows that attach to edges of a main window, with chaining, stacking, dual-mode docking, and persist/restore.</Description>
    <PackageTags>avalonia;window;snap;dock;satellite;panel;multi-window</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.*" />
    <!-- The vendored Dock.* stack IS this library (source vendored so the sealed Dock types can be
         broken/extended here), not third-party packages: SatelliteWindow inherits Dock's HostWindow, so the
         Dock public types are part of this library's API. During a normal BUILD these are plain references,
         so Dock types flow transitively to source consumers. During PACK (-p:SwPacking=true, set by the
         pack/publish step) they switch to PrivateAssets="all" so pack emits NO dangling <dependency> rows;
         the IncludeVendoredDockInPackage target then folds their DLLs into this one package's lib/<tfm>/. -->
    <ProjectReference Include="..\SatelliteWindows.Avalonia.Dock\src\SatelliteWindows.Dock.Avalonia\SatelliteWindows.Dock.Avalonia.csproj">
      <PrivateAssets Condition="'$(SwPacking)' == 'true'">all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\SatelliteWindows.Avalonia.Dock\src\SatelliteWindows.Dock.Avalonia.Themes.Fluent\SatelliteWindows.Dock.Avalonia.Themes.Fluent.csproj">
      <PrivateAssets Condition="'$(SwPacking)' == 'true'">all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\SatelliteWindows.Avalonia.Dock\src\SatelliteWindows.Dock.Controls.Recycling\SatelliteWindows.Dock.Controls.Recycling.csproj">
      <PrivateAssets Condition="'$(SwPacking)' == 'true'">all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\SatelliteWindows.Avalonia.Dock\src\SatelliteWindows.Dock.Model.Mvvm\SatelliteWindows.Dock.Model.Mvvm.csproj">
      <PrivateAssets Condition="'$(SwPacking)' == 'true'">all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\SatelliteWindows.Avalonia.Dock\src\SatelliteWindows.Dock.Serializer.SystemTextJson\SatelliteWindows.Dock.Serializer.SystemTextJson.csproj">
      <PrivateAssets Condition="'$(SwPacking)' == 'true'">all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- Fold the vendored Dock DLLs (and their transitive vendored deps) into this package's lib/<tfm>/ so it
       is one self-contained NuGet — no separate Dock packages. -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeVendoredDockInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="IncludeVendoredDockInPackage">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and '%(Extension)' == '.dll'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="SatelliteWindows.Avalonia.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    <None Include="..\SatelliteWindows.Avalonia.Dock\LICENSE-Dock.TXT" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
